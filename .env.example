# ============================================================
# Nityasādhanā Environment Configuration Architecture
# ============================================================
#
# 1. LOCAL DEVELOPMENT (.env.local):
#    - AUTH_SECRET: 32+ character random secret string
#    - NEXT_PUBLIC_APP_URL: http://localhost:3000
#
# 2. VERCEL PRODUCTION ENVIRONMENT (Vercel Project Settings -> Environment Variables):
#    - AUTH_SECRET: 32+ character cryptographically random secret string
#    - NEXT_PUBLIC_APP_URL: https://nityasadhana.vercel.app
#    - NEXT_PUBLIC_APP_ENV: production
#    - DATABASE_URL: postgresql://... (Optional if using PostgreSQL database)
#    - Assigned to: Production
# ============================================================

# ------------------------------------------------------------
# PUBLIC VARIABLES (Safe to expose to browser)
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://nityasadhana.vercel.app
NEXT_PUBLIC_APP_NAME=Nityasādhanā
NEXT_PUBLIC_APP_ENV=production

# ------------------------------------------------------------
# PRIVATE SERVER SECRETS (NEVER expose to browser / client code)
# CRITICAL: NEVER use NEXT_PUBLIC_ for these secrets!
# ------------------------------------------------------------
# Random 32+ character secret for cryptographic signing / encryption
AUTH_SECRET=your_32_character_random_auth_secret_here

# Optional PostgreSQL database connection URL
# DATABASE_URL=postgresql://user:password@host:5432/nityasadhana?sslmode=require

# Optional Email Service credentials for password reset delivery
# RESEND_API_KEY=re_your_resend_api_key_here
# EMAIL_FROM=Nityasādhanā <noreply@nityasadhana.app>
